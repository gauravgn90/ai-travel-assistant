{
  "name": "ai-travel-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Context-aware Singapore travel assistant combining a document knowledge base (RAG) with live data from MCP tools.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "kb:fetch": "tsx scripts/fetch-sources.ts",
    "kb:ingest": "tsx scripts/ingest.ts",
    "kb:search": "tsx scripts/search.ts",
    "kb:stats": "tsx scripts/index-stats.ts",
    "ask": "tsx scripts/ask.ts",
    "mcp:weather": "tsx mcp-servers/src/weather.ts",
    "mcp:currency": "tsx mcp-servers/src/currency.ts",
    "mcp:check": "tsx scripts/mcp-check.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.10",
    "@langchain/core": "^1.2.11",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/groq": "^1.3.1",
    "@langchain/openai": "^1.5.13",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "langchain": "^1.5.11",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
