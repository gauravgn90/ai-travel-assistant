# Copy to .env.local and set the key for whichever provider you choose.
#
# Keep values bare: no surrounding quotes, and no trailing comment on the same
# line as a value. `docker run --env-file` strips neither, and would read them
# as part of the key.

# google | openai | anthropic | groq
LLM_PROVIDER=google

# Optional. Leave blank to use the provider's default:
#   google     gemini-3.5-flash
#   openai     gpt-4o-mini
#   anthropic  claude-sonnet-5
#   groq       llama-3.3-70b-versatile
LLM_MODEL=

# Only the key for the selected provider is needed.
#   google     https://aistudio.google.com/apikey
#   openai     https://platform.openai.com/api-keys
#   anthropic  https://console.anthropic.com/settings/keys
#   groq       https://console.groq.com/keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional.
DESTINATION=Singapore
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.38
