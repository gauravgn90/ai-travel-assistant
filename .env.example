# Copy to .env.local and set the key for whichever provider you choose.
# google | openai | anthropic | groq
LLM_PROVIDER=google
# Optional, in code default Model is configured
LLM_MODEL=

# Required to work with LLM
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional.
DESTINATION=Singapore
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.38
