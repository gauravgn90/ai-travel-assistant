# Copy to .env.local and fill in one provider's key.
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------------
# openai | anthropic | groq | google
LLM_PROVIDER=openai

# Optional. Defaults per provider:
#   openai     gpt-4o-mini
#   anthropic  claude-sonnet-5
#   groq       llama-3.3-70b-versatile
#   google     gemini-2.5-flash
# Whatever you choose must support tool calling.
# LLM_MODEL=

# Only the key for the selected LLM_PROVIDER is required. Keys for the others
# can stay unset; /api/health reports which ones it found.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# Point the OpenAI-compatible path at another host — Ollama, LM Studio, vLLM,
# OpenRouter, or an Azure deployment. With Ollama, set LLM_PROVIDER=openai,
# OPENAI_API_KEY to any non-empty string, and pick a tool-calling model.
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
# OPENAI_BASE_URL=

# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=2048

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# openai | google | local
#
# "local" runs all-MiniLM-L6-v2 in-process through ONNX Runtime: no API key, no
# quota, weights cached on first use. It is the default when LLM_PROVIDER is
# anthropic or groq, because neither vendor sells an embedding endpoint.
#
# The index and the query must be embedded by the same model. Change this and
# you must re-run `npm run kb:ingest`.
EMBEDDING_PROVIDER=local

# Defaults: openai -> text-embedding-3-small, google -> text-embedding-004,
#           local -> Xenova/all-MiniLM-L6-v2
# EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Retrieval and tools
# ---------------------------------------------------------------------------
# DESTINATION=Singapore

# Chunks passed to the model per turn.
# RETRIEVAL_TOP_K=6

# Absolute cosine floor for "does the knowledge base cover this at all".
# Below it the assistant says so instead of answering from model memory.
# Calibrated for all-MiniLM-L6-v2 on this corpus; re-measure with
# `npm run kb:search` after changing embedding models.
# RETRIEVAL_MIN_SIMILARITY=0.38

# Model/tool round trips before the assistant is forced to answer.
# MAX_TOOL_ITERATIONS=4
# MCP_TOOL_TIMEOUT_MS=20000

# debug | info | warn | error | silent
# LOG_LEVEL=info
